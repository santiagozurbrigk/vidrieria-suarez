# ── Supabase ──────────────────────────────────────────────────────────────────
# Valores públicos: se exponen al navegador. Los obtenés en
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Requerida por el escaneo de facturas con IA (lib/actions/extraerFactura.ts).
# Sin esta variable el módulo de carga de facturas por foto/PDF no funciona.
# Sólo se usa en el servidor, nunca se expone al navegador.
ANTHROPIC_KEY=sk-ant-...
